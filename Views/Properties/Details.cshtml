@model RentRight.Models.Property
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Property Details";
    var currentUserId = UserManager.GetUserId(User);
}

<h2>Property Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.Address</dd>

        <dt class="col-sm-2">Rent Amount</dt>
        <dd class="col-sm-10">@Model.RentAmount.ToString("C")</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

    </dl>
</div>

@if (User.IsInRole("Admin") || (User.IsInRole("Landlord") && Model.LandlordId == currentUserId))
{
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
}
<a asp-action="Index" class="btn btn-secondary">Back</a>
