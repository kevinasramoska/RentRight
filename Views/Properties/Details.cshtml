@model RentRight.Features.Properties.Contracts.PropertyDetails

@{
    ViewData["Title"] = "Property Details";
}

<h2>Property Details</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Model.Address</dd>

        <dt class="col-sm-2">Rent Amount</dt>
        <dd class="col-sm-10">@Model.RentAmount.ToString("C")</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>

    </dl>
</div>

<partial name="_Location" model="Model" />

@if (Model.CanManage)
{
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
}
<a asp-action="Index" class="btn btn-secondary">Back</a>
