@using RentRight.Models
@model RentRight.ViewModels.MaintenanceRequestStatusUpdateViewModel

@{
    ViewData["Title"] = "Update Maintenance Status";
    var currentStatus = Model.CurrentStatus == MaintenanceRequestStatus.InProgress
        ? "In Progress"
        : Model.CurrentStatus.ToString();
}

<h2 class="mb-4">Update Maintenance Status</h2>

<p><strong>Property:</strong> @Model.PropertyTitle</p>
<p><strong>Tenant:</strong> @Model.TenantName</p>
<p><strong>Current status:</strong> @currentStatus</p>

@if (Model.AllowedStatuses.Count == 0)
{
    <div class="alert alert-info">This request is closed and has no further status transitions.</div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Back</a>
}
else
{
    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="NewStatus" class="form-label"></label>
            <select asp-for="NewStatus" asp-items="Model.AllowedStatuses" class="form-select">
                <option value="">Select the next status</option>
            </select>
            <span asp-validation-for="NewStatus" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Update Status</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
