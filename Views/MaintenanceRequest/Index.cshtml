@using RentRight.Models
@model RentRight.ViewModels.MaintenanceRequestIndexViewModel

@{
    ViewData["Title"] = Model.Heading;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@Model.Heading</h2>
    @if (Model.CanCreate)
    {
        <a asp-action="Create" class="btn btn-primary">Submit Maintenance Request</a>
    }
</div>

@if (User.IsInRole("Landlord") || User.IsInRole("Admin"))
{
    <p><a asp-controller="MaintenanceQueue" asp-action="Index">Open filtered work queue</a></p>
}

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (Model.Requests.Count == 0)
{
    <div class="alert alert-info">There are no maintenance requests to display.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>Property</th>
                <th>Tenant</th>
                <th>Description</th>
                <th>Submitted</th>
                <th>Status</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var request in Model.Requests)
            {
                var description = request.Description.Length > 100
                    ? request.Description[..100] + "…"
                    : request.Description;
                var status = request.Status == MaintenanceRequestStatus.InProgress
                    ? "In Progress"
                    : request.Status.ToString();

                <tr>
                    <td>@request.PropertyTitle</td>
                    <td>@request.TenantName</td>
                    <td>@description</td>
                    <td>@request.DateSubmitted.ToString("dd MMM yyyy HH:mm") UTC</td>
                    <td>@status</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">View</a>
                        @if (request.CanUpdateStatus)
                        {
                            <a asp-action="UpdateStatus" asp-route-id="@request.Id" class="btn btn-sm btn-outline-secondary">Update status</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
