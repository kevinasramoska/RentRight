@using RentRight.Models
@model RentRight.ViewModels.MaintenanceRequestDetailsViewModel

@{
    ViewData["Title"] = "Maintenance Request Details";
    var status = Model.Status == MaintenanceRequestStatus.InProgress
        ? "In Progress"
        : Model.Status.ToString();
}

<h2 class="mb-4">Maintenance Request #@Model.Id</h2>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<dl class="row">
    <dt class="col-sm-3">Property</dt>
    <dd class="col-sm-9">@Model.PropertyTitle</dd>

    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.PropertyAddress</dd>

    <dt class="col-sm-3">Tenant</dt>
    <dd class="col-sm-9">@Model.TenantName</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@status</dd>

    <dt class="col-sm-3">Submitted</dt>
    <dd class="col-sm-9">@Model.DateSubmitted.ToString("dd MMM yyyy HH:mm") UTC</dd>

    <dt class="col-sm-3">Last updated</dt>
    <dd class="col-sm-9">@Model.LastUpdatedUtc.ToString("dd MMM yyyy HH:mm") UTC</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9" style="white-space: pre-wrap;">@Model.Description</dd>
</dl>

<h3 class="h5">Status history</h3>
<ol>
    @foreach (var entry in Model.History)
    {
        <li>@entry.Status — @entry.OccurredUtc.ToString("dd MMM yyyy HH:mm") UTC
            @if (entry.IsLegacyBaseline) { <span>(Imported baseline; earlier transitions were not recorded)</span> }
        </li>
    }
</ol>

@if (Model.CanUpdateStatus)
{
    <a asp-action="UpdateStatus" asp-route-id="@Model.Id" class="btn btn-primary">Update Status</a>
}
<a asp-action="Index" class="btn btn-secondary">Back to Requests</a>
