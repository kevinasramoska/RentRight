@using RentRight.Models
@model RentRight.ViewModels.TenancyAdminIndexViewModel

@{
    ViewData["Title"] = "Tenancies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Tenancies</h2>
    <a asp-action="Create" class="btn btn-primary">Invite Tenant</a>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (Model.Tenancies.Count == 0)
{
    <div class="alert alert-info">No tenancies have been created.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>Property</th>
                <th>Tenant</th>
                <th>Dates</th>
                <th>Status</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var tenancy in Model.Tenancies)
            {
                <tr>
                    <td>
                        <strong>@tenancy.PropertyTitle</strong><br />
                        <span class="text-muted">@tenancy.PropertyAddress</span>
                    </td>
                    <td>
                        @tenancy.TenantName<br />
                        <span class="text-muted">@tenancy.TenantEmail</span>
                    </td>
                    <td>
                        @tenancy.StartDate.ToString("dd MMM yyyy")
                        –
                        @(tenancy.EndDate?.ToString("dd MMM yyyy") ?? "Open-ended")
                    </td>
                    <td>@tenancy.Status</td>
                    <td>
                        @if (tenancy.Status is TenancyStatus.Active or TenancyStatus.Pending)
                        {
                            <form asp-action="End" asp-route-id="@tenancy.Id" method="post">
                                <input type="hidden" name="ExpectedVersion" value="@tenancy.Version" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">End / Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
