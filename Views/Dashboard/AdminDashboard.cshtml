@model RentRight.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-5">
    <h2 class="fw-bold mb-4">Admin Dashboard</h2>

    <div class="row text-center">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="text-muted">Total Users</h5>
                    <h2 class="fw-bold">@Model.TotalUsers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="text-muted">Total Properties</h5>
                    <h2 class="fw-bold">@Model.TotalProperties</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Properties" asp-action="Index" class="btn btn-primary">Manage Properties</a>
        <a asp-controller="Tenancies" asp-action="Index" class="btn btn-outline-primary">Manage Tenancies</a>
        <a asp-controller="MaintenanceRequest" asp-action="Index" class="btn btn-outline-primary">Manage Maintenance Requests</a>
    </div>
</div>
