@model RentRight.ViewModels.AdminUserRolesViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<h2 class="mb-3">Admin Panel – User Role Management</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-striped align-middle">
    <thead class="table-light">
    <tr>
        <th>Full Name</th>
        <th>Email</th>
        <th>Roles</th>
        <th style="width: 250px;">Update Roles</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Users)
    {
        <tr>
            <td>@item.User.FullName</td>
            <td>@item.User.Email</td>
            <td>@string.Join(", ", item.Roles)</td>
            <td>
                <form asp-action="UpdateRoles" method="post" class="d-flex flex-column gap-2">
                    <input type="hidden" name="userId" value="@item.User.Id" />
                    <select name="selectedRoles" multiple class="form-select form-select-sm">
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <option value="@role" selected="@(item.Roles.Contains(role))">@role</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-primary">Update</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
