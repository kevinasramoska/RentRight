@page
@model RentRight.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="mb-3"><label asp-for="Input.Email"></label><input asp-for="Input.Email" class="form-control" autocomplete="username" /><span asp-validation-for="Input.Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.Password"></label><input asp-for="Input.Password" class="form-control" autocomplete="current-password" /><span asp-validation-for="Input.Password" class="text-danger"></span></div>
    <div class="mb-3"><input asp-for="Input.RememberMe" /><label asp-for="Input.RememberMe">Remember me</label></div>
    <button type="submit" class="btn btn-primary">Sign in</button>
</form>
@if (Model.CanRegister)
{
    <p class="mt-3"><a asp-page="./Register">Create a tenant account</a></p>
}
else
{
    <p class="mt-3">Sign-in is for existing accounts. Contact your administrator for account access or recovery.</p>
}
